rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() { return request.auth != null && request.auth.token.email_verified == true && request.auth.token.email == 'info@rgb-workshop.com'; }
    match /content/published { allow read: if true; allow write: if isAdmin(); }
    match /content/draft { allow read, write: if isAdmin(); }
    match /media/{mediaId} { allow read: if true; allow write: if isAdmin(); }
    match /projects/{projectId} { allow read, write: if isAdmin(); }
    match /projects/{projectId}/content/published { allow read: if true; allow write: if isAdmin(); }
    match /projects/{projectId}/content/draft { allow read, write: if isAdmin(); }
    match /miniGames/jigsawPuzzle { allow read: if true; allow write: if isAdmin(); }
    match /miniGames/jigsawPuzzle/versions/{versionId} { allow read: if true; allow write: if isAdmin(); }
    match /miniGames/peaceBunWhack { allow read: if true; allow write: if isAdmin(); }
    match /{document=**} { allow read, write: if false; }
  }
}
